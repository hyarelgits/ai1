[SECTION 3] FILE 2: app.py Flask Backend
from flask import Flask, jsonify
from flask_cors import CORS
import requests, time
app = Flask(__name__)
CORS(app)
@app.route('/')  # DECORATOR
def home(): return "BTCUSD AI Dashboard API Running - Binance $81,228 System"
@app.route('/api/price')
def get_price():
    url = "https://api.binance.com/api/v3/ticker/price?symbol=BTCUSDT"
    resp = requests.get(url, timeout=5)
    data = resp.json()
    price = float(data['price'])
    sl_level = 80600
    sl_hit = price < sl_level
    pnl = 409 if not sl_hit else -200
    cvd = 12.4
    bos = "bullish" if price > 81000 else "bearish"
    return jsonify({"symbol":"BTCUSD","price":price,"exchange":"Binance","sl":sl_level,"sl_hit":sl_hit,"pnl":pnl,"cvd":"+12.4M","bos":bos,"signals":["LONG","SHORT"]})
@app.route('/api/cvd')
def get_cvd(): return jsonify({"cvd":12.4,"unit":"M","trend":"bullish"})
if __name__ == '__main__': app.run(host='0.0.0.0', port=5000, debug=True)

Line-by-line: @app.route decorator adds routing, jsonify converts dict to JSON, CORS allows hyarelgits.github.io to call localhost:5000, host 0.0.0.0 allows VM host access, port 5000 Flask default

